{
  "comments": {
    "lineComment": "#",
    "blockComment": [
      "\"\"\"",
      "\"\"\""
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "`",
      "close": "`",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ],
    [
      "`",
      "`"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:async\\s+)?(?:def|class)|if|elif|else|for|while|try|except|finally|with|match|case)\\b.*:\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:elif|else|except|finally|case)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:(?:async\\s+)?def|class|if|elif|else|for|while|try|except|finally|with|match|case)\\b.*:\\s*(?:#.*)?$",
      "action": {
        "indent": "indent"
      }
    }
  ]
}
