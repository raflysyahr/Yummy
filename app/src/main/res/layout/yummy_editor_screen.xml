<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/yummy_editor_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/yummy_bg">

    <!-- App bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:background="@color/yummy_bar">

        <ImageButton
            android:id="@+id/yummy_btn_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="File Manager"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_yummy_menu"
            tools:ignore="HardcodedText" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_yummy_file"
            android:tint="@color/yummy_accent_green"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/yummy_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_semibold"
            android:maxLines="1"
            android:text="Main.py"
            android:textColor="@color/yummy_text"
            android:textSize="20sp"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/yummy_btn_terminal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Terminal"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_yummy_terminal"
            android:tint="@color/yummy_text"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/yummy_btn_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cari"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_yummy_search"
            android:tint="@color/yummy_text"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/yummy_btn_run"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Jalankan"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_yummy_play"
            android:tint="@color/yummy_accent_green"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/yummy_btn_save"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Simpan"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_yummy_save"
            android:tint="@color/yummy_text"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/yummy_divider" />

    <!-- Tab file -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:orientation="horizontal"
        android:background="@color/yummy_bar">

        <HorizontalScrollView
            android:id="@+id/yummy_tabs_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

                        <LinearLayout
                android:id="@+id/yummy_tabs_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/yummy_btn_new_tab"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Buat tab baru"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_yummy_add"
            android:tint="@color/yummy_text_dim"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/yummy_btn_tabs_menu"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Daftar tab"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_yummy_sort"
            android:tint="@color/yummy_text_dim"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <View
        android:id="@+id/yummy_editor_top_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/yummy_divider" />

    <!-- Area editor. Tahap 2: isi diganti editor sungguhan -->
    <FrameLayout
        android:id="@+id/yummy_editor_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.termux.app.editor.YummyCodeEditor
            android:id="@+id/yummy_code_editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <View
        android:id="@+id/yummy_editor_bottom_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/yummy_divider" />

    <!-- Status bar inspired by compact IDE status bars. -->
    <LinearLayout
        android:id="@+id/yummy_editor_status_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/yummy_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Ln"
                android:textColor="@color/yummy_text_dim"
                android:fontFamily="@font/nunito_regular"
                android:textSize="8sp" />
            <TextView
                android:id="@+id/yummy_status_pos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_semibold"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/yummy_text"
                android:textSize="10sp" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="26dp" android:background="@color/yummy_divider" />

        <LinearLayout
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Col"
                android:textColor="@color/yummy_text_dim"
                android:fontFamily="@font/nunito_regular"
                android:textSize="8sp" />
            <TextView
                android:id="@+id/yummy_status_col"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_semibold"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/yummy_text"
                android:textSize="10sp" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="26dp" android:background="@color/yummy_divider" />

        <LinearLayout
            android:layout_width="54dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Spaces:"
                android:textColor="@color/yummy_text_dim"
                android:fontFamily="@font/nunito_regular"
                android:textSize="8sp" />
            <TextView
                android:id="@+id/yummy_status_indent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_semibold"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/yummy_text"
                android:textSize="10sp" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="26dp" android:background="@color/yummy_divider" />

        <LinearLayout
            android:id="@+id/yummy_status_language_group"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="6dp">
            <ImageView
                android:id="@+id/yummy_status_lang_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                android:scaleType="fitCenter"
                android:contentDescription="Ikon bahasa" />
            <TextView
                android:id="@+id/yummy_status_lang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_semibold"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="Plain Text"
                android:textColor="@color/yummy_text"
                android:textSize="10sp" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="26dp" android:background="@color/yummy_divider" />

        <LinearLayout
            android:id="@+id/yummy_status_encoding_button"
            android:layout_width="76dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:contentDescription="Pilih encoding">
            <TextView
                android:id="@+id/yummy_status_enc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UTF-8"
                android:textColor="@color/yummy_text"
                android:fontFamily="@font/nunito_regular"
                android:textSize="10sp" />
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="5dp"
                android:src="@drawable/ic_yummy_chevron_down"
                android:tint="@color/yummy_text_dim"
                android:contentDescription="Buka daftar encoding" />
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="26dp" android:background="@color/yummy_divider" />

        <FrameLayout
            android:id="@+id/yummy_session_save_pill"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:layout_marginStart="1dp"
            android:foregroundGravity="center">
            <ImageView
                android:id="@+id/yummy_session_save_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Sesi tersimpan"
                android:src="@drawable/ic_yummy_session_sync" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:id="@+id/yummy_editor_status_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/yummy_divider" />

    <!-- Baris tombol bawah -->
    <LinearLayout
        android:id="@+id/yummy_keys_row"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/yummy_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/yummy_key_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Tab"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_yummy_tab_key"
            android:tint="@color/yummy_text"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/yummy_key_up"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Atas"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_yummy_up"
            android:tint="@color/yummy_text"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/yummy_key_down"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Bawah"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_yummy_down"
            android:tint="@color/yummy_text"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/yummy_key_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Kiri"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_yummy_left"
            android:tint="@color/yummy_text"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/yummy_key_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Kanan"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_yummy_right"
            android:tint="@color/yummy_text"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/yummy_key_undo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Undo"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_yummy_undo"
            android:tint="@color/yummy_text" />

        <ImageButton
            android:id="@+id/yummy_key_redo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Redo"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_yummy_redo"
            android:tint="@color/yummy_text" />

        <ImageButton
            android:id="@+id/yummy_key_paste"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Paste"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_yummy_clipboard_paste"
            android:tint="@color/yummy_text" />

    </LinearLayout>
</LinearLayout>
